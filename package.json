{
  "name": "dsh-balance-ball",
  "version": "0.1.0",
  "description": "悬浮球显示 DeepSeek 账户余额（OAuth 登录），附带实时价格、今日价格走势与 token 消耗估算区间。可拖动、可固定，点击展开详情面板。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarRob1n/dsh-account-balance.git"
  },
  "homepage": "https://github.com/StarRob1n/dsh-account-balance#readme",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "balance",
    "billing",
    "usage"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  }
}
